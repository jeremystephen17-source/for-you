<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>For My Favorite Person 💜</title>
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #0f0717;
      --card-bg: rgba(26, 11, 46, 0.75);
      --purple-accent: #b967ff;
      --purple-pink: #d946ef;
      --neon-glow: #a855f7;
      --text-light: #f3e8ff;
      --text-muted: #c084fc;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Poppins', sans-serif;
    }

    body {
      background: radial-gradient(circle at top center, #240a40 0%, var(--bg-dark) 80%);
      color: var(--text-light);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 30px 15px;
      overflow-x: hidden;
      position: relative;
    }

    /* Animated background glow circles */
    .glow-orb {
      position: absolute;
      width: 300px;
      height: 300px;
      background: radial-gradient(circle, rgba(185, 103, 255, 0.25) 0%, rgba(0,0,0,0) 70%);
      border-radius: 50%;
      z-index: 0;
      filter: blur(40px);
      animation: floatOrb 8s infinite alternate ease-in-out;
    }
    .orb-1 { top: -50px; left: -50px; }
    .orb-2 { bottom: 50px; right: -50px; }

    @keyframes floatOrb {
      0% { transform: translateY(0) scale(1); }
      100% { transform: translateY(30px) scale(1.1); }
    }

    /* Main Card Shell */
    .container {
      max-width: 650px;
      width: 100%;
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(185, 103, 255, 0.3);
      border-radius: 28px;
      padding: 40px 25px;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6), 0 0 25px rgba(185, 103, 255, 0.2);
      text-align: center;
      z-index: 1;
      position: relative;
    }

    h1.title {
      font-family: 'Dancing Script', cursive;
      font-size: 3.2rem;
      background: linear-gradient(135deg, #ffffff, var(--purple-accent), var(--purple-pink));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 8px;
      text-shadow: 0 0 20px rgba(185, 103, 255, 0.4);
    }

    p.subtitle {
      color: var(--text-muted);
      font-size: 1rem;
      letter-spacing: 1px;
      margin-bottom: 30px;
    }

    /* Fancy Glass Buttons */
    .btn-group {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 30px;
    }

    .custom-btn {
      background: linear-gradient(135deg, rgba(185, 103, 255, 0.2), rgba(217, 70, 239, 0.3));
      border: 1px solid rgba(217, 70, 239, 0.5);
      color: #fff;
      padding: 12px 24px;
      border-radius: 50px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      backdrop-filter: blur(8px);
      box-shadow: 0 4px 15px rgba(168, 85, 247, 0.2);
      transition: all 0.3s ease;
    }

    .custom-btn:hover {
      transform: translateY(-3px) scale(1.03);
      background: linear-gradient(135deg, var(--purple-accent), var(--purple-pink));
      box-shadow: 0 6px 20px rgba(217, 70, 239, 0.5);
    }

    /* Interactive Letter Container */
    .letter-box {
      display: none;
      background: rgba(15, 7, 23, 0.85);
      border: 1px dashed var(--purple-accent);
      border-radius: 20px;
      padding: 25px;
      margin-bottom: 35px;
      text-align: left;
      line-height: 1.8;
      font-size: 0.98rem;
      color: #eae0d5;
      animation: fadeIn 0.6s ease forwards;
    }

    .letter-box h3 {
      font-family: 'Dancing Script', cursive;
      font-size: 2rem;
      color: var(--purple-accent);
      margin-bottom: 10px;
    }

    /* Fancy Gallery Grid */
    .section-title {
      font-size: 1.3rem;
      color: var(--text-light);
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 18px;
    }

    .memory-card {
      position: relative;
      background: rgba(255, 255, 255, 0.04);
      border-radius: 18px;
      padding: 10px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      overflow: hidden;
      transition: all 0.3s ease;
    }

    .memory-card:hover {
      transform: translateY(-8px);
      border-color: var(--purple-accent);
      box-shadow: 0 10px 25px rgba(185, 103, 255, 0.3);
    }

    .memory-card img {
      width: 100%;
      height: 170px;
      object-fit: cover;
      border-radius: 12px;
    }

    .memory-card .caption {
      padding: 10px 5px 5px 5px;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    /* Pop-up Modal */
    .modal {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(8px);
      z-index: 100;
      justify-content: center;
      align-items: center;
    }

    .modal-content {
      background: var(--bg-dark);
      border: 2px solid var(--purple-pink);
      padding: 30px;
      border-radius: 24px;
      max-width: 400px;
      width: 90%;
      text-align: center;
      box-shadow: 0 0 30px var(--neon-glow);
      animation: popIn 0.3s ease;
    }

    .close-btn {
      margin-top: 20px;
      background: var(--purple-pink);
      border: none;
      color: white;
      padding: 8px 20px;
      border-radius: 20px;
      cursor: pointer;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-10deg); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes popIn {
      from { transform: scale(0.7); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
  </style>
</head>
<body>

  <div class="glow-orb orb-1"></div>
  <div class="glow-orb orb-2"></div>

  <div class="container">
    <h1 class="title">Hey Pretty Girl ✨</h1>
    <p class="subtitle">I BUILT THIS LITTLE SURPRISE CORNER FOR YOU 💜</p>

    <!-- Buttons -->
    <div class="btn-group">
      <button class="custom-btn" onclick="toggleLetter()">Read My Letter 💌</button>
      <button class="custom-btn" onclick="openSecretModal()">Special Surprise 🎁</button>
    </div>

    <!-- Letter Box -->
    <div class="letter-box" id="letterBox">
      <h3>My Dearest,</h3>
      <p>
        I created this page to remind you of how much you mean to me. Every moment spent with you is full of happiness, laughter, and cute memories. Thank you for being my favorite person every day! 💜
      </p>
      <p style="margin-top: 15px; text-align: right; font-weight: bold; color: var(--purple-accent);">
        Forever yours ✨
      </p>
    </div>

    <!-- Memory Gallery Section -->
    <div class="section-title">
      <span>Our Cutest Moments</span> 📸
    </div>

    <div class="gallery">
      <div class="memory-card">
        <img src="https://via.placeholder.com/300x300/2a0e45/ffffff?text=Our+Photo+1" alt="Memory 1">
        <div class="caption">The Best Day 💜</div>
      </div>
      <div class="memory-card">
        <img src="https://via.placeholder.com/300x300/2a0e45/ffffff?text=Our+Photo+2" alt="Memory 2">
        <div class="caption">Favorite Smile 😊</div>
      </div>
      <div class="memory-card">
        <img src="https://via.placeholder.com/300x300/2a0e45/ffffff?text=Our+Photo+3" alt="Memory 3">
        <div class="caption">Always Together ✨</div>
      </div>
    </div>
  </div>

  <!-- Pop-up Modal -->
  <div class="modal" id="secretModal">
    <div class="modal-content">
      <h2 style="color: var(--purple-accent); font-family: 'Dancing Script', cursive; font-size: 2.2rem;">Surprise! 🎉</h2>
      <p style="margin-top: 15px; color: var(--text-light); line-height: 1.6;">
        You just scanned the code and found this! I love you so much! 💜✨
      </p>
      <button class="close-btn" onclick="closeSecretModal()">Close 💜</button>
    </div>
  </div>

  <script>
    function toggleLetter() {
      const box = document.getElementById('letterBox');
      box.style.display = (box.style.display === 'block') ? 'none' : 'block';
    }

    function openSecretModal() {
      document.getElementById('secretModal').style.display = 'flex';
    }

    function closeSecretModal() {
      document.getElementById('secretModal').style.display = 'none';
    }
  </script>
</body>
</html>
